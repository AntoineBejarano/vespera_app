generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String?   @unique
  emailVerified      DateTime?
  image              String?
  passwordHash       String?
  /// Hexclave user id (v1 IdP). Prefer externalAuthUserId for new code.
  hexclaveId         String?   @unique
  /// Portable IdP subject (Hexclave today, Supabase auth.users.id later)
  externalAuthUserId String?   @unique
  /// hexclave | supabase | …
  authProvider       String?   @default("hexclave")
  /// free | creator | studio | premium (legacy alias of studio)
  plan               String    @default("free")
  /// Stripe Customer id — apex SFW billing only (never After Dark)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  dailyMessageCount  Int       @default(0)
  dailyResetAt       DateTime  @default(now())
  ageVerifiedAt      DateTime?
  adultConsentAt     DateTime?
  /// HEAA stub — result/token from age-assurance provider (never store ID docs)
  ageAssuranceStatus   String?
  ageAssuranceProvider String?
  ageAssuredAt         DateTime?
  ageAssuranceExpiresAt DateTime?
  ageBand              String?
  countryCode          String?
  /// When user accepted current Terms (clickwrap)
  tosAcceptedAt      DateTime?
  /// When user accepted current Privacy Policy (clickwrap)
  privacyAcceptedAt  DateTime?
  /// LEGAL_VERSION string accepted at last attest
  legalVersionAccepted String?
  /// B2B: accepted Platform Operator Responsibilities (channels/API)
  platformOperatorAcceptedAt DateTime?
  platformOperatorVersion  String?
  preferredModel     String?
  language           String    @default("en")
  /// Legacy single-bot link (admin). Peers use TelegramPeer.
  telegramId         String?   @unique
  telegramUsername   String?
  telegramFirstName  String?
  telegramLastName   String?
  /// Shadow account auto-created for a Telegram peer (not admin login)
  isTelegramPeer     Boolean   @default(false)
  /// Last selected workspace (UX only — never authz)
  activeWorkspaceId  String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  characters          Character[]         @relation("CharacterCreator")
  settings            UserSettings?
  conversations       Conversation[]
  memories            Memory[]
  telegramBots        TelegramBot[]
  telegramPeers       TelegramPeer[]
  apiKeys             UserApiKey[]
  knowledgePacks      KnowledgePack[]
  workspaceMembers    WorkspaceMember[]
  workspaceInvitesSent WorkspaceInvite[]  @relation("WorkspaceInviteSender")
  ownershipTransfersFrom WorkspaceOwnershipTransfer[] @relation("OwnershipFrom")
  ownershipTransfersTo   WorkspaceOwnershipTransfer[] @relation("OwnershipTo")
  activeWorkspace     Workspace?          @relation("UserActiveWorkspace", fields: [activeWorkspaceId], references: [id], onDelete: SetNull)
  relationshipSubjects RelationshipSubject[] @relation("SubjectWebUser")
  adultApprovalsGiven AdultWorkspaceApproval[] @relation("AdultApprovalApprover")

  @@index([email])
  @@index([telegramId])
  @@index([hexclaveId])
  @@index([externalAuthUserId])
}

/// Product tenant. Authz is WorkspaceMember.role + local capability map (not IdP).
model Workspace {
  id                 String   @id @default(cuid())
  name               String
  /// Hexclave Team id (v1) — mapping only, never used as domain PK
  externalAuthTeamId String?  @unique
  /// Denormalized: true only while an approved, non-revoked, non-expired approval exists.
  /// Authorizes CONFIG of adult capabilities — never end-user adult delivery alone.
  adultEnabled       Boolean  @default(false)
  adultApprovedAt    DateTime?
  adultApprovedBy    String?
  adultPolicyVersion String?
  adultTermsAcceptedAt DateTime?
  /// none | pending | approved | revoked | expired | restricted
  adultRiskStatus    String   @default("none")
  /// JSON string array of allowed capability ids
  adultAllowedCapabilities String?
  /// JSON string array of ISO country codes (empty/null = unset)
  adultAllowedCountries    String?
  adultAgeAssuranceRequired Boolean @default(true)
  adultAgeAssuranceProvider String?
  adultApprovalExpiresAt DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  members      WorkspaceMember[]
  invites      WorkspaceInvite[]
  characters   Character[]
  knowledgePacks KnowledgePack[]
  apiKeys      UserApiKey[]
  telegramBots TelegramBot[]
  ownershipTransfers WorkspaceOwnershipTransfer[]
  activeForUsers User[] @relation("UserActiveWorkspace")
  relationshipSubjects RelationshipSubject[]
  adultApprovals AdultWorkspaceApproval[]

  @@index([createdAt])
  @@index([adultEnabled])
}

/// Audited After Dark partner approval. Source of truth for adult config access.
model AdultWorkspaceApproval {
  id                     String    @id @default(cuid())
  workspaceId            String
  /// pending | approved | revoked | expired
  status                 String    @default("pending")
  approvedByUserId       String?
  approvedAt             DateTime?
  reason                 String
  policyVersion          String
  /// JSON string array of capability ids granted
  capabilities           String    @default("[]")
  /// JSON string array of ISO country codes
  allowedCountries       String    @default("[]")
  ageAssuranceRequired   Boolean   @default(true)
  ageAssuranceProvider   String?
  expiresAt              DateTime?
  revokedAt              DateTime?
  revokeReason           String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  approvedBy User?     @relation("AdultApprovalApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([approvedByUserId])
  @@index([expiresAt])
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  /// owner | admin | editor | viewer  (operator reserved for phase 2)
  role        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, role])
}

model WorkspaceInvite {
  id          String    @id @default(cuid())
  workspaceId String
  email       String
  /// admin | editor | viewer (never owner)
  role        String
  token       String    @unique
  invitedByUserId String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("WorkspaceInviteSender", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([workspaceId, email])
  @@index([email])
  @@index([token])
}

model WorkspaceOwnershipTransfer {
  id              String    @id @default(cuid())
  workspaceId     String
  fromUserId      String
  toUserId        String
  token           String    @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fromUser  User      @relation("OwnershipFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser    User      @relation("OwnershipTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([token])
}

/// Account-level API key for CLI / AI agents (create personas, manage).
/// Distinct from Character chat keys (vesp_…). Secret shown once on create.
model UserApiKey {
  id              String    @id @default(cuid())
  workspaceId     String
  /// Creator (actor) — not the tenant owner
  userId          String
  /// Display name set by the user (e.g. "cursor", "ci")
  name            String    @default("default")
  /// First chars for UI listing (e.g. vsk_abcd1234)
  keyPrefix       String
  /// Last 4 of secret for display (••••8JQ2)
  lastFour        String    @default("")
  /// sha256 hex of the full secret
  keyHash         String    @unique
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([userId])
  @@index([keyPrefix])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model UserSettings {
  id              String   @id @default(cuid())
  userId          String   @unique
  preferredModel  String?
  language        String   @default("en")
  /** Nickname override for web/admin only. Telegram uses telegramFirstName. */
  howToAddress    String?
  adultConsent    Boolean  @default(false)
  dailyLimit      Int      @default(40)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Persisted product/funnel event stream. Keep this lightweight: it powers
/// paywall analytics, lifecycle emails, and ops dashboards.
model ProductEvent {
  id          String   @id @default(cuid())
  userId      String?
  workspaceId String?
  type        String
  feature     String?
  surface     String   @default("apex_sfw")
  plan        String?
  contextJson Json?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([type, createdAt])
  @@index([feature, createdAt])
}

/// User-level notification consent/preferences. The first funnel ships email,
/// but channel is open-ended for future in-app/push/Telegram lifecycle nudges.
model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String
  channel   String
  topic     String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, channel, topic])
  @@index([userId, channel])
}

/// Dedupe ledger for lifecycle sends and in-app notifications.
model NotificationDelivery {
  id          String    @id @default(cuid())
  userId      String?
  channel     String
  topic       String
  templateId  String?
  status      String    @default("pending")
  dedupeKey   String    @unique
  error       String?   @db.Text
  metaJson    Json?
  sentAt      DateTime?
  skippedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([topic, status])
  @@index([status, createdAt])
}

/// Records monetization intent before leaving for Stripe. Useful for abandoned
/// checkout recovery and attribution back to the exact paywall trigger.
model CheckoutIntent {
  id              String    @id @default(cuid())
  userId          String
  workspaceId     String?
  plan            String
  reason          String?
  source          String?
  status          String    @default("started")
  stripeSessionId String?   @unique
  checkoutUrl     String?   @db.Text
  metaJson        Json?
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  canceledAt      DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([userId, startedAt])
  @@index([status, startedAt])
  @@index([reason, startedAt])
}

/// Global operator-controlled platform settings. Superadmin-only.
model PlatformSetting {
  key             String   @id
  value           Json
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([updatedAt])
}

/// Programmatic SEO pages generated by the operator automation.
model SeoGeneratedPage {
  id               String    @id @default(cuid())
  slug             String    @unique
  title            String
  h1               String
  metaDescription  String    @db.Text
  summary          String    @db.Text
  category         String
  audience         String?
  useCase          String
  intent           String?
  status           String    @default("draft")
  topicFingerprint String    @unique
  contentJson      Json
  qaJson           Json?
  score            Int       @default(0)
  model            String
  reviewerModel    String?
  costCents        Int       @default(0)
  publishedAt      DateTime?
  generatedAt      DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, publishedAt])
  @@index([category, status])
  @@index([generatedAt])
}

/// One cron/manual run of the SEO automation.
model SeoGenerationRun {
  id             String    @id @default(cuid())
  source         String
  status         String    @default("running")
  settingsJson   Json
  pagesAttempted Int       @default(0)
  pagesCreated   Int       @default(0)
  pagesPublished Int       @default(0)
  costCents      Int       @default(0)
  error          String?   @db.Text
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, startedAt])
  @@index([source, startedAt])
}

model Character {
  id           String   @id @default(cuid())
  /// Tenant owner of this persona
  workspaceId  String
  /// Creator actor (legacy field name; treat as createdByUserId)
  userId       String
  updatedByUserId String?
  name         String
  identityJson Json
  /// Meuxe-style layered persona (markdown docs stored in DB for multi-tenant)
  soulMd       String?  @db.Text
  styleMd      String?  @db.Text
  rulesMd      String?  @db.Text
  contextMd    String?  @db.Text
  metaJson     Json?
  intensity    Int      @default(3)
  /// OpenRouter model id for this persona (falls back to User.preferredModel)
  preferredModel String?
  limitsJson   Json?
  active       Boolean  @default(false)
  /// Chat key secret — prefer hash lookup; kept for legacy keys until rotated
  apiKey       String?  @unique
  /// sha256 of chat key (vesp_…) when hashed storage is used
  apiKeyHash   String?  @unique
  apiKeyPrefix String?
  apiKeyLastFour String?
  /// Public profile URL: vesperer.com/c/{slug} (globally unique when set)
  slug         String?  @unique
  isPublic     Boolean  @default(false)
  tagline      String?
  openingLine  String?  @db.Text
  categories   String[] @default([])
  allowFork    Boolean  @default(true)
  /// Adult-oriented public listing (routes to After Dark discovery)
  isAdult      Boolean  @default(false)
  /// Registry semver: major.minor (e.g. 2.4)
  versionMajor Int      @default(1)
  versionMinor Int      @default(0)
  /// Creator license declaration for the registry page
  /// private | public | fork_allowed | non_commercial | commercial
  license      String   @default("fork_allowed")
  /// Declared distribution targets (vesperer, telegram, web, chai, sillytavern, api…)
  channels     String[] @default([])
  forkedFromId String?
  archivedAt   DateTime?
  archivedByUserId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user           User                @relation("CharacterCreator", fields: [userId], references: [id], onDelete: Cascade)
  forkedFrom     Character?          @relation("CharacterForks", fields: [forkedFromId], references: [id], onDelete: SetNull)
  forks          Character[]         @relation("CharacterForks")
  versions       CharacterVersion[]
  conversations   Conversation[]
  memories        Memory[]
  summaries       Summary[]
  relationships   RelationshipState[]
  openIntentions  OpenIntention[]
  photos          CharacterPhoto[]
  telegramBots    TelegramBot[]
  knowledgeLinks  CharacterKnowledgePack[]

  @@index([workspaceId])
  @@index([workspaceId, active])
  @@index([userId])
  @@index([userId, active])
  @@index([apiKey])
  @@index([apiKeyHash])
  @@index([slug])
  @@index([isPublic, updatedAt])
  @@index([isPublic, isAdult])
  @@index([workspaceId, archivedAt])
  @@index([isPublic, license])
}

/// Cross-channel continuity identity for a real person talking to personas.
/// Affect, intentions, and memories key off subjectId — not raw channel user ids.
model RelationshipSubject {
  id                 String   @id @default(cuid())
  workspaceId        String
  displayName        String?
  /// Web / Hexclave account (bridge). Prefer resolving via this when present.
  webUserId          String?
  telegramUserId     String?
  phoneNumberHash    String?
  /// API / CLI / CRM peer id (stable external string)
  externalCustomerId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  webUser        User?               @relation("SubjectWebUser", fields: [webUserId], references: [id], onDelete: SetNull)
  relationships  RelationshipState[]
  openIntentions OpenIntention[]
  memories       Memory[]

  @@index([workspaceId])
  @@index([webUserId])
  @@index([telegramUserId])
  @@index([externalCustomerId])
  @@unique([workspaceId, webUserId])
  @@unique([workspaceId, telegramUserId])
  @@unique([workspaceId, externalCustomerId])
}

/// Immutable snapshot of a persona for the Persona Registry version history.
model CharacterVersion {
  id              String   @id @default(cuid())
  characterId     String
  versionMajor    Int
  versionMinor    Int
  changelog       String?
  name            String
  tagline         String?
  openingLine     String?  @db.Text
  soulMd          String?  @db.Text
  styleMd         String?  @db.Text
  rulesMd         String?  @db.Text
  contextMd       String?  @db.Text
  metaJson        Json?
  license         String
  createdByUserId String?
  createdAt       DateTime @default(now())

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, versionMajor, versionMinor])
  @@index([characterId, createdAt])
}

model CharacterPhoto {
  id          String   @id @default(cuid())
  characterId String
  url         String
  caption     String?
  /// Primary category / free-text kind slug
  kind        String   @default("selfie")
  /// Extra labels for matching chat photo requests
  tags        String[] @default([])
  /// Avatar / cover for persona list + detail header
  isProfile   Boolean  @default(false)
  createdAt   DateTime @default(now())

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId])
  @@index([characterId, kind])
  @@index([characterId, isProfile])
}

model RelationshipState {
  id          String   @id @default(cuid())
  subjectId   String
  /// Legacy bridge during migration — prefer subjectId
  userId      String?
  characterId String
  mood        String   @default("neutral")
  /// Affect dims — always clamped 0–1 in application code
  trust       Float    @default(0.35)
  affection   Float    @default(0.3)
  energy      Float    @default(0.7)
  familiarity Float    @default(0.2)
  openness    Float    @default(0.4)
  playfulness Float    @default(0.4)
  /// Controlled tone enum (see CURRENT_TONES in persona/affect.ts)
  currentTone String   @default("neutral")
  summary     String?  @db.Text
  /// Extensible affect payload — validated with Zod before prompt inject
  affectJson  Json?
  /// Optimistic concurrency for async post-turn updates
  version     Int      @default(0)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  subject   RelationshipSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  character Character           @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([subjectId, characterId])
  @@index([subjectId])
  @@index([characterId])
  @@index([userId])
}

/// Open goals / commitments / questions the persona maintains toward a subject.
model OpenIntention {
  id               String    @id @default(cuid())
  subjectId        String
  characterId      String
  /// desire | goal | fear | commitment | question | plan
  kind             String
  content          String    @db.Text
  /// open | done | dropped
  status           String    @default("open")
  priority         Int       @default(0)
  dueHint          String?
  dueAt            DateTime?
  sourceMessageId  String?
  confidence       Float     @default(0.7)
  dedupeKey        String
  lastConfirmedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  subject   RelationshipSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  character Character           @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, subjectId, dedupeKey])
  @@index([subjectId, characterId, status])
  @@index([characterId, status, priority])
}

/// Idempotency ledger for async post-turn jobs (memory / affect / intentions).
model PostTurnJob {
  id             String   @id @default(cuid())
  conversationId String
  upToMessageId  String
  /// memory | affect | intentions | all
  kind           String   @default("all")
  status         String   @default("pending")
  error          String?  @db.Text
  createdAt      DateTime @default(now())
  completedAt    DateTime?

  @@unique([conversationId, upToMessageId, kind])
  @@index([status, createdAt])
}

/// A Telegram bot token bound to one Character (the girl).
/// N bots can point at the same Character and talk to N peers in parallel.
model TelegramBot {
  id             String   @id @default(cuid())
  workspaceId    String
  ownerUserId    String
  characterId    String
  token          String   @unique
  username       String
  webhookSecret  String   @unique
  label          String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     User           @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  character Character      @relation(fields: [characterId], references: [id], onDelete: Cascade)
  peers     TelegramPeer[]

  @@index([workspaceId])
  @@index([ownerUserId])
  @@index([characterId])
  @@index([webhookSecret])
}

/// One Telegram human talking to one bot → isolated User + memory + relationship.
model TelegramPeer {
  id               String   @id @default(cuid())
  botId            String
  userId           String
  telegramUserId   String
  telegramUsername String?
  telegramFirstName String?
  telegramLastName String?
  /// Self-attest 18+ via Telegram before chatting
  ageAttestedAt    DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  bot  TelegramBot @relation(fields: [botId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([botId, telegramUserId])
  @@index([userId])
  @@index([telegramUserId])
}

model Conversation {
  id          String   @id @default(cuid())
  userId      String
  characterId String
  title       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  messages  Message[]
  summaries Summary[]

  @@index([userId])
  @@index([characterId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String   @db.Text
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Summary {
  id             String   @id @default(cuid())
  conversationId String
  characterId    String
  content        String   @db.Text
  upToMessageId  String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  character    Character    @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([characterId])
}

model Memory {
  id          String   @id @default(cuid())
  subjectId   String
  /// Legacy bridge — prefer subjectId for continuity
  userId      String?
  characterId String
  type        String
  content     String   @db.Text
  vectorId    String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subject   RelationshipSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  user      User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  character Character           @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([subjectId, characterId])
  @@index([userId, characterId])
  @@index([characterId, type])
}

/// Curated knowledge pack (Plato Essentials, museum guide, AI employee docs…).
/// Full document text lives in Upstash Vector chunks — never in Postgres.
model KnowledgePack {
  id          String   @id @default(cuid())
  workspaceId String
  /// Creator actor
  userId      String
  /// Stable slug for seeds (e.g. plato-essentials); unique per workspace
  slug        String?
  name        String
  description String?  @db.Text
  language    String   @default("en")
  active      Boolean  @default(true)
  /// Seed template key if created from a preset (config only — not hardcoded ingest logic)
  seedKey     String?
  documentCount Int    @default(0)
  chunkCount  Int      @default(0)
  archivedAt  DateTime?
  archivedByUserId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace  Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user       User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sources    KnowledgeSource[]
  jobs       KnowledgeIngestJob[]
  characters CharacterKnowledgePack[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@index([workspaceId, active])
  @@index([userId])
  @@index([userId, active])
}

/// Source provenance + ingest state. No full document body stored here.
model KnowledgeSource {
  id               String   @id @default(cuid())
  knowledgePackId  String
  /// generic_url | huggingface | gutenberg | mediawiki | object_storage | user_owned
  provider         String
  /// Provider-specific external id (ebook id, datasetId, page title, object key…)
  externalId       String
  canonicalUrl     String?
  /// Dataset revision / git sha / MediaWiki revid / content version
  datasetRevision  String?
  license          String?
  language         String   @default("en")
  /// SHA-256 of normalized source payload (idempotency / change detection)
  checksum         String?
  /// pending | inspecting | ready | ingesting | indexed | failed | cancelled | disabled
  status           String   @default("pending")
  enabled          Boolean  @default(true)
  /// Adapter config (dataset split, textColumn, ebook format, host…). Not document body.
  configJson       Json
  /// License + provenance summary from inspect()
  provenanceJson   Json?
  /// Object storage key when original file is snapshotted (R2/S3)
  objectKey        String?
  documentCount    Int      @default(0)
  chunkCount       Int      @default(0)
  lastError        String?  @db.Text
  lastIngestedAt   DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  knowledgePack KnowledgePack        @relation(fields: [knowledgePackId], references: [id], onDelete: Cascade)
  jobs          KnowledgeIngestJob[]

  @@unique([knowledgePackId, provider, externalId])
  @@index([knowledgePackId])
  @@index([knowledgePackId, status])
  @@index([provider, externalId])
  @@index([checksum])
}

/// Async ingest / reindex / delete-vectors job (Postgres-backed queue).
model KnowledgeIngestJob {
  id              String   @id @default(cuid())
  knowledgePackId String
  sourceId        String?
  /// ingest | reindex | delete_source_vectors
  kind            String   @default("ingest")
  /// queued | running | succeeded | failed | cancelled
  status          String   @default("queued")
  progress        Int      @default(0)
  documentsDone   Int      @default(0)
  documentsTotal  Int      @default(0)
  chunksDone      Int      @default(0)
  attempt         Int      @default(0)
  maxAttempts     Int      @default(3)
  /// Opaque cursor for batched / streaming resume
  cursorJson      Json?
  error           String?  @db.Text
  logJson         Json?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  knowledgePack KnowledgePack    @relation(fields: [knowledgePackId], references: [id], onDelete: Cascade)
  source        KnowledgeSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([knowledgePackId, status])
  @@index([sourceId])
}

/// Many-to-many: one pack can power several personas (Plato, tutor clones…).
model CharacterKnowledgePack {
  id              String   @id @default(cuid())
  characterId     String
  knowledgePackId String
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  character     Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)
  knowledgePack KnowledgePack @relation(fields: [knowledgePackId], references: [id], onDelete: Cascade)

  @@unique([characterId, knowledgePackId])
  @@index([characterId])
  @@index([knowledgePackId])
}
