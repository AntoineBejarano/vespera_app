# App
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_TRUST_HOST=true
NEXTAUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Postgres (Railway)
DATABASE_URL=postgresql://user:password@host:5432/railway

# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-...
DEFAULT_MODEL=cognitivecomputations/dolphin-mistral-24b-venice-edition
# Comma-separated allowlist
ALLOWED_MODELS=cognitivecomputations/dolphin-mistral-24b-venice-edition,gryphe/mythomax-l2-13b,nousresearch/hermes-3-llama-3.1-70b,nousresearch/hermes-4-70b

# Upstash Redis (optional — falls back to memory)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upstash Vector (optional — falls back to Postgres text search)
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# Free tier
DAILY_MESSAGE_LIMIT=40

# Telegram (post-MVP)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Monetization placeholder (adult-friendly processor later)
PREMIUM_ENABLED=false
