# App
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_TRUST_HOST=true
NEXTAUTH_URL=http://localhost:3000
# Canonical public URL (SEO + redirects). On Railway MUST be the public https URL
# (e.g. https://vesperaapp-production.up.railway.app or https://vesperer.com).
# Never use http://0.0.0.0:PORT — that is only the container bind address.
APP_URL=http://localhost:3000

# After Dark (XXX) subdomain — same deploy, host-based routing in src/proxy.ts
# Add xxx.vesperer.com as a custom domain on the Railway service.
NEXT_PUBLIC_AFTER_DARK_HOST=xxx.vesperer.com
NEXT_PUBLIC_AFTER_DARK_URL=https://xxx.vesperer.com

# Postgres — ONLY Railway (no local DB, ever).
# Use DATABASE_PUBLIC_URL from the Railway Postgres service for local CLI/migrate.
# Inside Railway app containers, the private DATABASE_URL (*.railway.internal) is fine.
# Do NOT point this at 127.0.0.1 or start a Docker Postgres for this project.
DATABASE_URL=postgresql://user:password@proxy.rlwy.net:PORT/railway

# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-...
DEFAULT_MODEL=cognitivecomputations/dolphin-mistral-24b-venice-edition
# Comma-separated allowlist
ALLOWED_MODELS=cognitivecomputations/dolphin-mistral-24b-venice-edition,gryphe/mythomax-l2-13b,nousresearch/hermes-3-llama-3.1-70b,nousresearch/hermes-4-70b

# Upstash Redis (optional — falls back to memory)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upstash Vector (optional — falls back to Postgres text search)
# Knowledge Packs require an embedding-enabled index (e.g. BGE-M3).
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# Knowledge ingest worker (optional — falls back to AUTH_SECRET / in-process)
KNOWLEDGE_JOB_SECRET=

# Hugging Face (optional — higher rate limits for dataset rows API)
HUGGINGFACE_TOKEN=
# HF_TOKEN=

# Object storage for Knowledge Pack file snapshots (Cloudflare R2 or S3-compatible)
# Postgres stores only objectKey — never the file body.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
# R2_REGION=auto
# Or generic S3:
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_REGION=auto

# Free tier
DAILY_MESSAGE_LIMIT=40

# Telegram (producto — web es admin/test)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Monetization — apex SFW via Stripe; After Dark never uses these keys
PREMIUM_ENABLED=false
# Stripe (vesperer.com Creator/Studio only — create Products+Prices in Dashboard)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs (price_…), one Product per tier
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_STUDIO=
# Optional publishable key if you add Stripe.js client UI later
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Safety — set true to block all AI outbound replies (emergency)
SAFETY_KILL_SWITCH=false

# Legal entity — Deevly Labs LTD (deevlylabs.com; Companies House 16506991)
# Vesperer is a product of Deevly Labs, not a separate company.
LEGAL_CONTACT_EMAIL=legal@mail.vesperer.com
ABUSE_EMAIL=abuse@mail.vesperer.com
# LEGAL_COMPANY_WEBSITE=https://deevlylabs.com
# Defaults match registered office; override only if counsel directs:
# LEGAL_REGISTERED_ADDRESS=128 City Road, London, United Kingdom, EC1V 2NX
# LEGAL_JURISDICTION=England and Wales, United Kingdom
# LEGAL_GOVERNING_LAW=England and Wales

# Legal / compliance (self-attest gate; counsel must finalize entity details)
# LEGAL_VERSION is code-defined in src/lib/legal/constants.ts
# Inbound: Resend receiving on mail.vesperer.com (+ managed *.resend.app).
# Webhook: /api/webhooks/resend → SUPERADMIN_EMAILS (needs RESEND_WEBHOOK_SECRET).

# Identity adapter: hexclave (default) | supabase (future — see docs/supabase-migration-checklist.md)
AUTH_PROVIDER=hexclave

# Platform superadmins (comma-separated). Always includes antubejar96@gmail.com in code.
# Can impersonate Owner/Admin/Editor/Viewer via Debug role switcher in the app nav.
SUPERADMIN_EMAILS=antubejar96@gmail.com

# Hexclave (multi-tenant auth — cloud)
NEXT_PUBLIC_HEXCLAVE_API_URL=https://api.stack-auth.com
NEXT_PUBLIC_HEXCLAVE_PROJECT_ID=1c800406-1c97-4bb5-984e-926a4aae6505
HEXCLAVE_PROJECT_ID=1c800406-1c97-4bb5-984e-926a4aae6505
HEXCLAVE_SECRET_SERVER_KEY=

# ElevenLabs (server-only — never NEXT_PUBLIC_)
ELEVENLABS_API_KEY=

# Resend (transactional email — server-only)
# Create key at https://resend.com/api-keys — never commit the secret.
RESEND_API_KEY=
# Sending + receiving domain in Resend: mail.vesperer.com (verified).
# EMAIL_FROM=Vesperer <noreply@mail.vesperer.com>
EMAIL_FROM=
# Defaults to LEGAL_CONTACT_EMAIL
EMAIL_REPLY_TO=
# From resend.webhooks.create — used by /api/webhooks/resend
RESEND_WEBHOOK_SECRET=
